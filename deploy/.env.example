# ─────────────────────────────────────────────────────────────
# Afina2 · переменные окружения стека (скопируйте в .env и заполните)
# .env НЕ коммитится: содержит пароли и секреты.
# ─────────────────────────────────────────────────────────────

# ── Публичный адрес приложения (для писем со ссылкой входа) ──
APP_BASE_URL=https://afina.company.ru

# ── Порты ──
HTTP_PORT=80
HTTPS_PORT=443

# ── PostgreSQL ──
DB_NAME=afina2
DB_OWNER_USER=afina2
DB_OWNER_PASSWORD=ЗАМЕНИТЕ_НА_СЛОЖНЫЙ_ПАРОЛЬ
# Владелец схемы (DDL, Flyway)
DB_MIGRATOR_USER=afina_migrator
DB_MIGRATOR_PASSWORD=ЗАМЕНИТЕ_НА_СЛОЖНЫЙ_ПАРОЛЬ
# Приложение (только DML)
DB_USER=afina_app
DB_PASSWORD=ЗАМЕНИТЕ_НА_СЛОЖНЫЙ_ПАРОЛЬ
# Аудитор (только чтение), опционально
DB_AUDITOR_USER=afina_auditor
DB_AUDITOR_PASSWORD=

# ── Безопасность ──
# IP-адреса/подсети, с которых доступна админка (через запятую, CIDR допустим)
ADMIN_IP_WHITELIST=127.0.0.1,::1,10.0.0.0/8
# true — только HTTPS (обязательно в проде)
SECURE_COOKIES=true
TRUSTSTORE_PASSWORD=

# ── Почта (magic-link для входа клиентов) ──
MAIL_MODE=smtp
MAIL_HOST=smtp.company.ru
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@company.ru
MAIL_FROM_NAME=Афина

# ── Госключ (по умолчанию выключен) ──
GOSKLYUCH_ENABLED=false
GOSKLYUCH_PROVIDER=disabled
GOSKLYUCH_SIGNER=unavailable

# ── Образы (для сертифицированного контура укажите свои) ──
POSTGRES_IMAGE=postgres:15
BACKEND_BASE_IMAGE=eclipse-temurin:17-jre
ANGIE_IMAGE=docker.angie.software/angie:1.12.3-alpine

# ── Каталоги на хосте (пути относительно каталога deploy/) ──
#   certs   — truststore и корневые сертификаты УЦ (монтируется только на чтение)
#   secrets — admins.env со списком администраторов (только чтение)
#   tls     — сертификат и ключ Angie для HTTPS
# Ключи шифрования Afina2 создаёт сама в отдельном томе keys (см. compose).
CERTS_DIR_HOST=./certs
SECRETS_DIR_HOST=./secrets
TLS_DIR_HOST=./certs/tls

# ── JVM ──
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
