# ─────────────────────────────────────────────────────────────
# Afina2 · frontend (SPA) — сборка Node, раздача сертифицированным Angie
# Node присутствует только на стадии сборки и в поставку не входит.
# ─────────────────────────────────────────────────────────────
ARG BUILD_IMAGE=node:22-alpine
ARG BASE_IMAGE=docker.angie.software/angie:1.12.3-alpine

FROM ${BUILD_IMAGE} AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
# Адрес API относительный (/api) — проксирует Angie
RUN npm run build

# ─────────────────────────────────────────────────────────────
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="Afina2 Web" \
      org.opencontainers.image.description="Кабинет Afina2 (React SPA) под Angie" \
      org.opencontainers.image.vendor="Afina"

ENV TZ=Europe/Moscow

COPY --from=build /app/dist /usr/share/angie/html
COPY deploy/angie.conf /etc/angie/angie.conf
COPY deploy/security-headers.conf /etc/angie/security-headers.conf

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O - http://127.0.0.1/nginx-health || exit 1

STOPSIGNAL SIGQUIT
CMD ["angie", "-g", "daemon off;"]
