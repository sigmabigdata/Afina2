# Build stage (Node не попадает в runtime)
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Runtime: сертифицированный Angie
FROM docker.angie.software/angie:1.12.3-alpine
COPY --from=build /app/dist /usr/share/angie/html
COPY deploy/angie.conf /etc/angie/angie.conf
EXPOSE 80
