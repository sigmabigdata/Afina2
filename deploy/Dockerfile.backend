# ─────────────────────────────────────────────────────────────
# Afina2 · backend
#
# Multi-stage: сборка Maven → runtime.
# Для сертифицированного контура runtime-образ меняется на Astra Linux SE
# с Axiom JDK Pro и КриптоПро CSP (см. deploy/README.md):
#   docker build -f deploy/Dockerfile.backend \
#     --build-arg BASE_IMAGE=registry.company.ru/astra:1.8_jdk17 .
# ─────────────────────────────────────────────────────────────
ARG BUILD_IMAGE=maven:3.9-eclipse-temurin-17
ARG BASE_IMAGE=eclipse-temurin:17-jre

FROM ${BUILD_IMAGE} AS build

WORKDIR /build

# JCSP — проприетарные библиотеки КриптоПро, в Maven Central отсутствуют.
# Устанавливаем в локальный .m2 из каталога dist/libs (см. deploy/README.md).
COPY dist/libs ./libs
RUN set -e; \
    install_jar() { \
        file="$1"; group="$2"; artifact="$3"; version="$4"; \
        dir="/root/.m2/repository/$(echo "$group" | tr . /)/$artifact/$version"; \
        mkdir -p "$dir"; \
        cp "/build/libs/$file" "$dir/$artifact-$version.jar"; \
        printf '<project><modelVersion>4.0.0</modelVersion><groupId>%s</groupId><artifactId>%s</artifactId><version>%s</version><packaging>jar</packaging></project>' \
            "$group" "$artifact" "$version" > "$dir/$artifact-$version.pom"; \
    }; \
    V=5.0.49800; G=ru.cryptopro.jcsp; \
    install_jar JCSP.jar        $G jcsp          $V; \
    install_jar JCP.jar         $G jcp           $V; \
    install_jar JCryptoP.jar    $G jcryptop      $V; \
    install_jar JCPRevCheck.jar $G jcp-revcheck  $V; \
    install_jar JCPRevTools.jar $G jcp-revtools  $V; \
    install_jar CAdES.jar       $G cades         $V; \
    install_jar AdES-core.jar   $G ades-core     $V; \
    install_jar ASN1P.jar       $G asn1p         $V; \
    install_jar asn1rt.jar      $G asn1rt        $V; \
    install_jar cmsutil.jar     $G cmsutil       $V; \
    install_jar JCPxml.jar      $G jcp-xml       $V; \
    install_jar XAdES.jar       $G xades         $V; \
    install_jar XMLDSigRI.jar   $G xmldsigri     $V; \
    install_jar Rutoken.jar     $G rutoken       $V

# Сборка приложения (JCSP уже в локальном .m2)
COPY backend/pom.xml ./
COPY backend/src ./src
RUN mvn -B -DskipTests package

# ─────────────────────────────────────────────────────────────
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="Afina2 Backend" \
      org.opencontainers.image.description="Документы, УКЭП (ГОСТ 34.10-2012), Госключ" \
      org.opencontainers.image.vendor="Afina"

ENV TZ=Europe/Moscow \
    LANG=C.UTF-8 \
    JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8"

# Непривилегированный пользователь
RUN groupadd --system --gid 1001 afina \
 && useradd --system --uid 1001 --gid afina --home-dir /app --shell /usr/sbin/nologin afina \
 && mkdir -p /app/storage /app/backups /app/logs /app/crls /app/secrets \
 && chown -R afina:afina /app

WORKDIR /app

COPY --from=build --chown=afina:afina /build/target/afina2-backend.jar /app/app.jar
COPY --chown=afina:afina deploy/scripts/entrypoint.sh /app/entrypoint.sh
RUN chmod 0555 /app/entrypoint.sh

USER afina
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["sh", "-c", "wget -q -O - http://127.0.0.1:8080/api/v1/health || exit 1"]

ENTRYPOINT ["/app/entrypoint.sh"]
